<configure xmlns="http://namespaces.zope.org/zope" 
	xmlns:five="http://namespaces.zope.org/five">

<subscriber for="Products.Naaya.interfaces.INySite zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".events.addedNySite" />

<subscriber for="Products.Naaya.interfaces.INySite zope.lifecycleevent.interfaces.IObjectRemovedEvent"
      handler=".events.removedNySite" />

<subscriber for="Products.Naaya.interfaces.INySite zope.lifecycleevent.interfaces.IObjectMovedEvent"
      handler=".events.movedNySite" />

<subscriber for="Products.Naaya.interfaces.INyFolder zope.lifecycleevent.interfaces.IObjectRemovedEvent"
      handler=".events.removedNyFolder" />

</configure>
