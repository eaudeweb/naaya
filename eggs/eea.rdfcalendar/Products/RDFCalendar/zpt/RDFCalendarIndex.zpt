<metal:block use-macro="here/standard_template_macro"><metal:block fill-slot="body">

<style type="text/css" tal:content="structure here/default_css"></style>

<span tal:replace="structure python:here.show_events_list(request['month'], request['year'], day=0)" tal:condition="python:request.has_key('month') and request.has_key('year')" />
<span tal:replace="structure python:here.show_events_list(month=str(here.getMonth()), year=str(here.getYear()), day=0)" tal:condition="not:python:request.has_key('month') or request.has_key('year')" />

</metal:block></metal:block>
